 # Rules are rendered and deployed only by the PRO alerts module.
groups:
  - name: streamforge-availability
    rules:
%{ for container in web_containers ~}
      - alert: WebContainerMissing
        expr: absent(container_last_seen{name="${container}"}) and on() (up{job="cadvisor"} == 1)
        for: 2m
        labels:
          severity: critical
          service: streamforge-web
          container: "${container}"
        annotations:
          summary: "Web container ${container} is missing"
          description: "cAdvisor has not reported ${container} for at least 2 minutes."
          action: "Check the Docker container status and logs."
%{ endfor ~}
      - alert: WebInstanceUnreachable
        expr: probe_success{job="blackbox", service="streamforge-web"} == 0
        for: 2m
        labels:
          severity: critical
          service: streamforge-web
        annotations:
          summary: "A StreamForge Web instance is unreachable"
          description: "HTTP health probe failed for {{ $labels.container }} ({{ $labels.instance }})."
          action: "Check the Web container healthcheck, dependencies, and logs."

      - alert: DockerContainerUnhealthy
        expr: container_health_state{name=~"${environment}_.*"} == 0
        for: 1m
        labels:
          severity: critical
          service: docker-container
        annotations:
          summary: "Container {{ $labels.name }} is unhealthy"
          description: "Docker reports the configured healthcheck for {{ $labels.name }} as unhealthy."
          action: "Inspect the container healthcheck output and recent logs."

      - alert: AllWebReplicasDown
        expr: sum(probe_success{job="blackbox", service="streamforge-web"}) == 0
        for: 1m
        labels:
          severity: critical
          service: streamforge-web
        annotations:
          summary: "All StreamForge Web replicas are unavailable"
          description: "No Web replica is responding to its HTTP health probe."
          action: "Check the configured Web replicas, their dependencies, and the load balancer."

      - alert: LoadBalancerUnreachable
        expr: probe_success{job="blackbox", service="streamforge-load-balancer"} == 0
        for: 2m
        labels:
          severity: critical
          service: streamforge-load-balancer
        annotations:
          summary: "Nginx Load Balancer is unreachable"
          description: "The HTTP health probe to the StreamForge load balancer failed."
          action: "Check ${environment}_load_balancer and its upstream configuration."

      - alert: MinIODown
        expr: probe_success{job="blackbox", service="minio"} == 0
        for: 2m
        labels:
          severity: critical
          service: minio
        annotations:
          summary: "MinIO/Silo is unavailable"
          description: "The MinIO readiness endpoint did not return HTTP 2xx."
          action: "Check ${environment}_minio and its logs; verify the storage volume is healthy."

      - alert: MySQLDown
        expr: probe_success{job="blackbox", service="mysql"} == 0
        for: 2m
        labels:
          severity: critical
          service: mysql
        annotations:
          summary: "MySQL is unavailable"
          description: "The TCP connection probe to MySQL failed."
          action: "Check ${environment}_database and its logs."

%{ if cache_enabled ~}
      - alert: RedisDown
        expr: probe_success{job="blackbox", service="redis"} == 0
        for: 2m
        labels:
          severity: critical
          service: redis
        annotations:
          summary: "Redis is unavailable"
          description: "The TCP connection probe to Redis failed."
          action: "Check ${environment}_redis and its logs."
%{ endif ~}

      - alert: PrometheusTargetDown
        expr: up{job="cadvisor"} == 0
        for: 2m
        labels:
          severity: critical
          service: cadvisor
        annotations:
          summary: "cAdvisor metrics target is down"
          description: "Prometheus cannot scrape the cAdvisor target."
          action: "Check ${environment}_cadvisor and Prometheus scrape logs."

      - alert: BlackboxExporterDown
        expr: up{job="blackbox_exporter"} == 0
        for: 2m
        labels:
          severity: critical
          service: blackbox-exporter
        annotations:
          summary: "Blackbox Exporter is down"
          description: "Prometheus cannot scrape Blackbox Exporter."
          action: "Check ${environment}_blackbox_exporter; service reachability probes are unavailable."

      - alert: NodeExporterDown
        expr: up{job="node_exporter"} == 0
        for: 2m
        labels:
          severity: critical
          service: node-exporter
        annotations:
          summary: "Node Exporter is down"
          description: "Prometheus cannot collect host disk metrics."
          action: "Check ${environment}_node_exporter and its host filesystem mount."

      - alert: AlertmanagerDown
        expr: up{job="alertmanager"} == 0
        for: 2m
        labels:
          severity: critical
          service: alertmanager
        annotations:
          summary: "Alertmanager is down"
          description: "Prometheus cannot reach Alertmanager; Telegram notifications cannot be delivered."
          action: "Check ${environment}_alertmanager logs and Telegram configuration."

  - name: streamforge-resource-usage
    rules:
      - alert: ContainerHighCPU
        expr: |
          sum by (name) (
            rate(container_cpu_usage_seconds_total{name=~"${environment}_.*", cpu="total"}[5m])
          ) / scalar(machine_cpu_cores) * 100 > ${cpu_warning_threshold}
        for: 10m
        labels:
          severity: warning
          service: container-performance
        annotations:
          summary: "Container {{ $labels.name }} has high CPU usage"
          description: "{{ $labels.name }} has used more than ${cpu_warning_threshold}% of host CPU capacity for 10 minutes."
          value: '{{ printf "%.1f%%" $value }}'
          action: "Inspect the container's workload and logs."

      - alert: ContainerCriticalCPU
        expr: |
          sum by (name) (
            rate(container_cpu_usage_seconds_total{name=~"${environment}_.*", cpu="total"}[5m])
          ) / scalar(machine_cpu_cores) * 100 > ${cpu_critical_threshold}
        for: 5m
        labels:
          severity: critical
          service: container-performance
        annotations:
          summary: "Container {{ $labels.name }} has critical CPU usage"
          description: "{{ $labels.name }} has used more than ${cpu_critical_threshold}% of host CPU capacity for 5 minutes."
          value: '{{ printf "%.1f%%" $value }}'
          action: "Investigate the workload immediately."

      - alert: ContainerHighMemory
        expr: |
          max by (name) (
            container_memory_working_set_bytes{name=~"${environment}_.*"}
            / on (instance, job) machine_memory_bytes * 100
          ) > ${memory_warning_threshold}
        for: 10m
        labels:
          severity: warning
          service: container-performance
        annotations:
          summary: "Container {{ $labels.name }} has high memory usage"
          description: "{{ $labels.name }} is using more than ${memory_warning_threshold}% of total host RAM for 10 minutes."
          value: '{{ printf "%.1f%%" $value }}'
          action: "Inspect the container's memory use and workload."

      - alert: ContainerCriticalMemory
        expr: |
          max by (name) (
            container_memory_working_set_bytes{name=~"${environment}_.*"}
            / on (instance, job) machine_memory_bytes * 100
          ) > ${memory_critical_threshold}
        for: 5m
        labels:
          severity: critical
          service: container-performance
        annotations:
          summary: "Container {{ $labels.name }} has critical memory usage"
          description: "{{ $labels.name }} is using more than ${memory_critical_threshold}% of total host RAM for 5 minutes."
          value: '{{ printf "%.1f%%" $value }}'
          action: "Investigate memory pressure immediately."

      - alert: HostDiskUsageWarning
        expr: |
          (
            1 - node_filesystem_avail_bytes{job="node_exporter", mountpoint="/", fstype!~"tmpfs|overlay"}
            / node_filesystem_size_bytes{job="node_exporter", mountpoint="/", fstype!~"tmpfs|overlay"}
          ) * 100 > ${disk_warning_threshold}
        for: 5m
        labels:
          severity: warning
          service: host-disk
        annotations:
          summary: "Host disk usage exceeds ${disk_warning_threshold}%"
          description: "The root filesystem is more than ${disk_warning_threshold}% full."
          value: '{{ printf "%.1f%%" $value }}'
          action: "Free disk space or expand the host filesystem."

      - alert: HostDiskUsageCritical
        expr: |
          (
            1 - node_filesystem_avail_bytes{job="node_exporter", mountpoint="/", fstype!~"tmpfs|overlay"}
            / node_filesystem_size_bytes{job="node_exporter", mountpoint="/", fstype!~"tmpfs|overlay"}
          ) * 100 > ${disk_critical_threshold}
        for: 2m
        labels:
          severity: critical
          service: host-disk
        annotations:
          summary: "Host disk usage exceeds ${disk_critical_threshold}%"
          description: "The root filesystem is more than ${disk_critical_threshold}% full."
          value: '{{ printf "%.1f%%" $value }}'
          action: "Free disk space urgently to avoid service failures."
