 # Rules are rendered and deployed only by the PRO alerts module.
groups:
  - name: streamforge-availability
    rules:
%{ for container in web_containers ~}
      - alert: WebContainerMissing
        expr: |
          (
            absent(container_last_seen{name="${container}"})
            or
            (time() - container_last_seen{name="${container}"} > 20)
          )
          and on() (max(up{job="cadvisor"}) == 1)
        for: 15s
        labels:
          severity: critical
          service: streamforge-web
          container: "${container}"
        annotations:
          summary: "Web container ${container} is missing"
          description: "cAdvisor has not detected ${container} for more than 20 seconds."
          action: "Check the Docker container status and logs."
%{ endfor ~}
      - alert: DockerContainerUnhealthy
        expr: (container_health_state{name=~"${environment}_.*"} == 0 and on(name) (time() - container_last_seen{name=~"${environment}_.*"} < 45)) and on() (up{job="cadvisor"} == 1)
        for: 1m
        labels:
          severity: critical
          service: docker-container
        annotations:
          summary: "Container {{ $labels.name }} is unhealthy"
          description: "Docker reports the configured healthcheck for {{ $labels.name }} as unhealthy."
          action: "Inspect the container healthcheck output and recent logs."

      - alert: AllWebReplicasDown
        expr: |
          (
            sum(
              (container_health_state{name=~"^${environment}_web_[0-9]+$"} == 1)
              and on(name) (time() - container_last_seen{name=~"^${environment}_web_[0-9]+$"} < 20)
            )
            or vector(0)
          )
          == 0
          and on() (up{job="cadvisor"} == 1)
        for: 1m
        labels:
          severity: critical
          service: streamforge-web
        annotations:
          summary: "All StreamForge Web replicas are unavailable"
          description: "No Web replica has a healthy Docker HTTP healthcheck."
          action: "Check the configured Web replicas, their dependencies, and the load balancer."

      - alert: LoadBalancerUnreachable
        expr: |
          (
            container_health_state{name="${environment}_load_balancer"} == 0
            or absent(container_last_seen{name="${environment}_load_balancer"})
            or (time() - container_last_seen{name="${environment}_load_balancer"} > 20)
          )
          and on() (up{job="cadvisor"} == 1)
        for: 2m
        labels:
          severity: critical
          service: streamforge-load-balancer
          container: "${environment}_load_balancer"
        annotations:
          summary: "Nginx Load Balancer is unhealthy"
          description: "The Docker healthcheck for ${environment}_load_balancer failed or the container is missing."
          action: "Check ${environment}_load_balancer and its upstream configuration."

      - alert: MinIODown
        expr: |
          (
            container_health_state{name="${environment}_minio"} == 0
            or absent(container_last_seen{name="${environment}_minio"})
            or (time() - container_last_seen{name="${environment}_minio"} > 20)
          )
          and on() (up{job="cadvisor"} == 1)
        for: 2m
        labels:
          severity: critical
          service: minio
          container: "${environment}_minio"
        annotations:
          summary: "MinIO/Silo is unavailable"
          description: "The Docker readiness healthcheck for ${environment}_minio failed or the container is missing."
          action: "Check ${environment}_minio and its logs; verify the storage volume is healthy."

      - alert: MySQLDown
        expr: |
          (
            container_health_state{name="${environment}_database"} == 0
            or absent(container_last_seen{name="${environment}_database"})
            or (time() - container_last_seen{name="${environment}_database"} > 20)
          )
          and on() (up{job="cadvisor"} == 1)
        for: 2m
        labels:
          severity: critical
          service: mysql
          container: "${environment}_database"
        annotations:
          summary: "MySQL is unavailable"
          description: "The Docker SQL healthcheck for ${environment}_database failed or the container is missing."
          action: "Check ${environment}_database and its logs."

%{ if cache_enabled ~}
      - alert: RedisDown
        expr: |
          (
            container_health_state{name="${environment}_redis"} == 0
            or absent(container_last_seen{name="${environment}_redis"})
            or (time() - container_last_seen{name="${environment}_redis"} > 20)
          )
          and on() (up{job="cadvisor"} == 1)
        for: 2m
        labels:
          severity: critical
          service: redis
          container: "${environment}_redis"
        annotations:
          summary: "Redis is unavailable"
          description: "The Docker PING healthcheck for ${environment}_redis failed or the container is missing."
          action: "Check ${environment}_redis and its logs."
%{ endif ~}

      - alert: PrometheusTargetDown
        expr: up{job="cadvisor"} == 0
        for: 2m
        labels:
          severity: critical
          service: cadvisor
        annotations:
          summary: "cAdvisor metrics target is down"
          description: "Prometheus cannot scrape the cAdvisor target."
          action: "Check ${environment}_cadvisor and Prometheus scrape logs."

      - alert: AlertmanagerDown
        expr: up{job="alertmanager"} == 0
        for: 2m
        labels:
          severity: critical
          service: alertmanager
        annotations:
          summary: "Alertmanager is down"
          description: "Prometheus cannot reach Alertmanager; Telegram notifications cannot be delivered."
          action: "Check ${environment}_alertmanager logs and Telegram configuration."

  - name: streamforge-resource-usage
    rules:
      - alert: ContainerHighCPU
        expr: |
          sum by (name) (
            rate(container_cpu_usage_seconds_total{name=~"${environment}_.*", cpu="total"}[5m])
          ) / scalar(machine_cpu_cores) * 100 > ${cpu_warning_threshold}
        for: 10m
        labels:
          severity: warning
          service: container-performance
        annotations:
          summary: "Container {{ $labels.name }} has high CPU usage"
          description: "{{ $labels.name }} has used more than ${cpu_warning_threshold}% of host CPU capacity for 10 minutes."
          value: '{{ printf "%.1f%%" $value }}'
          action: "Inspect the container's workload and logs."

      - alert: ContainerCriticalCPU
        expr: |
          sum by (name) (
            rate(container_cpu_usage_seconds_total{name=~"${environment}_.*", cpu="total"}[5m])
          ) / scalar(machine_cpu_cores) * 100 > ${cpu_critical_threshold}
        for: 5m
        labels:
          severity: critical
          service: container-performance
        annotations:
          summary: "Container {{ $labels.name }} has critical CPU usage"
          description: "{{ $labels.name }} has used more than ${cpu_critical_threshold}% of host CPU capacity for 5 minutes."
          value: '{{ printf "%.1f%%" $value }}'
          action: "Investigate the workload immediately."

      - alert: ContainerHighMemory
        expr: |
          max by (name) (
            container_memory_working_set_bytes{name=~"${environment}_.*"}
            / on (instance, job) machine_memory_bytes * 100
          ) > ${memory_warning_threshold}
        for: 10m
        labels:
          severity: warning
          service: container-performance
        annotations:
          summary: "Container {{ $labels.name }} has high memory usage"
          description: "{{ $labels.name }} is using more than ${memory_warning_threshold}% of total host RAM for 10 minutes."
          value: '{{ printf "%.1f%%" $value }}'
          action: "Inspect the container's memory use and workload."

      - alert: ContainerCriticalMemory
        expr: |
          max by (name) (
            container_memory_working_set_bytes{name=~"${environment}_.*"}
            / on (instance, job) machine_memory_bytes * 100
          ) > ${memory_critical_threshold}
        for: 5m
        labels:
          severity: critical
          service: container-performance
        annotations:
          summary: "Container {{ $labels.name }} has critical memory usage"
          description: "{{ $labels.name }} is using more than ${memory_critical_threshold}% of total host RAM for 5 minutes."
          value: '{{ printf "%.1f%%" $value }}'
          action: "Investigate memory pressure immediately."
