global:
  scrape_interval: 15s
  evaluation_interval: 15s

%{ if alerts_enabled ~}
rule_files:
  - /etc/prometheus/alert.rules.yml

alerting:
  alertmanagers:
    - static_configs:
        - targets:
            - ${alertmanager_target}
%{ endif ~}

scrape_configs:
  - job_name: prometheus
    static_configs:
      - targets: ["${environment}_prometheus:9090"]

  - job_name: cadvisor
    static_configs:
      - targets: ["${environment}_cadvisor:8080"]

  - job_name: node_exporter
    static_configs:
      - targets: ["${environment}_node_exporter:9100"]

  - job_name: blackbox_exporter
    static_configs:
      - targets: ["${environment}_blackbox_exporter:9115"]

  - job_name: blackbox
    metrics_path: /probe
    static_configs:
%{ for probe in probes ~}
      - targets: ["${probe.target}"]
        labels:
          module: "${probe.module}"
          service: "${probe.service}"
          container: "${probe.container}"
%{ endfor ~}
    relabel_configs:
      - source_labels: [__address__]
        target_label: __param_target
      - source_labels: [module]
        target_label: __param_module
      - source_labels: [__param_target]
        target_label: instance
      - target_label: __address__
        replacement: "${environment}_blackbox_exporter:9115"

%{ if alerts_enabled ~}
  - job_name: alertmanager
    static_configs:
      - targets: ["${alertmanager_target}"]
%{ endif ~}
