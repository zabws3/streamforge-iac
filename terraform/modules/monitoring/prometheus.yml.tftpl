global:
  scrape_interval: 15s
  evaluation_interval: 15s

%{ if alerts_enabled ~}
rule_files:
  - /etc/prometheus/alert.rules.yml

alerting:
  alertmanagers:
    - static_configs:
        - targets:
            - ${alertmanager_target}
%{ endif ~}

scrape_configs:
  - job_name: prometheus
    static_configs:
      - targets: ["${environment}_prometheus:9090"]

  - job_name: cadvisor
    static_configs:
      - targets: ["${environment}_cadvisor:8080"]

%{ if alerts_enabled ~}
  - job_name: alertmanager
    static_configs:
      - targets: ["${alertmanager_target}"]
%{ endif ~}
