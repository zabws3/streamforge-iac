    {
      "datasource": {
        "type": "prometheus",
        "uid": "PBFA97CFB590B2093"
      },
      "description": "Health state is shown only when cAdvisor data is fresh (under 45 seconds); stale samples map to UNKNOWN (-1), not healthy or down.",
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "mappings": [
            {
              "options": {
                "-1": {
                  "color": "gray",
                  "text": "UNKNOWN — no healthcheck"
                },
                "0": {
                  "color": "red",
                  "text": "UNHEALTHY"
                },
                "1": {
                  "color": "green",
                  "text": "HEALTHY"
                }
              },
              "type": "value"
            }
          ],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": 1
              }
            ]
          },
          "unit": "short"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 7,
        "w": 12,
        "x": 0,
        "y": 65
      },
      "id": 32,
      "options": {
        "cellHeight": "sm",
        "footer": {
          "countRows": false,
          "fields": "",
          "reducer": [
            "sum"
          ],
          "show": false
        },
        "showHeader": true
      },
      "targets": [
        {
          "editorMode": "code",
          "expr": "(max by (name) (container_health_state{name=~\"^__ENVIRONMENT___.+\",name!=\"\"} and on (name) (time() - container_last_seen{name=~\"^__ENVIRONMENT___.+\",name!=\"\"} < 45))) or (-1 + max by (name) (0 * container_last_seen{name=~\"^__ENVIRONMENT___.+\",name!=\"\"} and on (name) (time() - container_last_seen{name=~\"^__ENVIRONMENT___.+\",name!=\"\"} >= 45)))",
          "format": "table",
          "instant": true,
          "legendFormat": "{{name}}",
          "range": false,
          "refId": "A"
        }
      ],
      "title": "Docker healthcheck state (unknown is not down)",
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true,
              "__name__": true,
              "id": true,
              "image": true,
              "instance": true,
              "job": true
            },
            "indexByName": {
              "name": 0,
              "Value": 1
            },
            "renameByName": {
              "Value": "Health state",
              "name": "Container"
            }
          }
        }
      ],
      "type": "table"
    },
