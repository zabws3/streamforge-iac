      "targets": [
        {
          "editorMode": "code",
          "expr": "count(container_last_seen{name=~\"^__ENVIRONMENT___.+\",name!=\"\"} and on (name) (time() - container_last_seen{name=~\"^__ENVIRONMENT___.+\",name!=\"\"} < 45))",
