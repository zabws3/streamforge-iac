            "sum"
          ],
          "show": false
        },
        "showHeader": true
      },
      "targets": [
        {
          "editorMode": "code",
          "expr": "max by (name) (container_health_state{name=~\"${container:regex}\",name!=\"\"})",
          "format": "table",
          "instant": true,
          "legendFormat": "{{name}}",
          "range": false,
          "refId": "A"
        }
      ],
      "title": "Docker healthcheck state (unknown is not down)",
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true,
              "__name__": true,
              "id": true,
              "image": true,
              "instance": true,
              "job": true
            },
            "indexByName": {
              "name": 0,
              "Value": 1
            },
            "renameByName": {
              "Value": "Health state",
              "name": "Container"
            }
          }
        }
      ],
      "type": "table"
    },
